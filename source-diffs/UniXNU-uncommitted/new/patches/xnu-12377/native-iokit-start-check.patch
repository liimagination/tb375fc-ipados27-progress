 int
+mac_iokit_check_service_start(kauth_cred_t cred, io_object_t service)
+{
+	int error;
+
+	_Static_assert(__builtin_offsetof(struct mac_policy_ops, mpo_iokit_check_service_start) == 0x1e8,
+	    "24A446 service-start policy slot changed");
+	MAC_CHECK(iokit_check_service_start, cred, service);
+	return error;
